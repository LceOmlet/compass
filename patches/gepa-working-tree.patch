+        {"origin": "admission", "q": 10},
+        {"origin": "admission", "q": 11},
+        {"origin": "admission", "q": 12},
+        {"origin": "admission", "q": 13},
+    ]
+    parent_eval = EvaluationBatch(
+        outputs=["parent"],
+        scores=[0.4],
+        trajectories=[{"stage": "parent"}],
+        num_metric_calls=1,
+    )
+    child_eval = EvaluationBatch(
+        outputs=["child-0", "child-1"],
+        scores=[0.7, 0.8],
+        trajectories=[{"stage": "child-0"}, {"stage": "child-1"}],
+        num_metric_calls=2,
