+import pytest
+
+from gepa.core.adapter import EvaluationBatch
+from gepa.core.engine import GEPAEngine
+from gepa.core.state import GEPAState, ValsetEvaluation
+from gepa.proposer.base import CandidateProposal, SubsampleEvaluation
+from gepa.proposer.reflective_mutation.admission import AdmissionPlan
+from gepa.strategies.acceptance import StrictImprovementAcceptance
+from gepa.strategies.proposal_selection import AllImprovements
+
+
+def _state() -> GEPAState:
+    state = GEPAState(
+        {"prompt": "seed"},
+        ValsetEvaluation(outputs_by_val_id={}, scores_by_val_id={}),
+    )
+    state.i = 0
+    state.full_program_trace.append({"i": 1})
+    return state
+
+
+def _engine() -> GEPAEngine:
+    engine = object.__new__(GEPAEngine)
+    engine.acceptance_criterion = StrictImprovementAcceptance()
+    engine.selection_strategy = AllImprovements()
+    engine.logger = MagicMock()
+    engine.adapter = MagicMock()
+    engine.callbacks = None
+    engine.merge_proposer = None
+    engine._evaluate_programs_on_valset = MagicMock()
+    engine._add_evaluated_program = MagicMock(return_value=(1, 0))
+    engine._log_proposal_lm_calls = MagicMock()
+    return engine
+
+
+def _proposal(*, before: float, after: float, admission: bool) -> CandidateProposal:
+    plan = (
+        AdmissionPlan(
+            evaluation_ids=(11,),
+            evaluation_batch=({"id": 11},),
+            eval_before=EvaluationBatch(
+                outputs=["old"],
+                scores=[before],
+                trajectories=[{"trace": "old"}],
+            ),
+            birth_propose_ids=(3,),
+        )
+        if admission
+        else None
+    )
+    return CandidateProposal(
+        candidate={"prompt": "child"},
+        parent_program_ids=[0],
+        subsample_indices=[11],
+        subsample_scores_before=[before],
+        subsample_scores_after=[after],
+        eval_before=SubsampleEvaluation(
+            scores=[before],
+            outputs=["old"],
+            trajectories=[{"trace": "old"}],
+        ),
+        eval_after=SubsampleEvaluation(
+            scores=[after],
+            outputs=["new"],
+            trajectories=[{"trace": "new"}],
+        ),
+        admission_plan=plan,
+    )
+
+
+def test_admission_acceptance_directly_adds_stage4_result_without_val_policy():
+    engine = _engine()
+    proposal = _proposal(before=0.25, after=0.75, admission=True)
+
+    assert engine._run_reflective_batch([proposal], _state())
+
+    engine._evaluate_programs_on_valset.assert_not_called()
+    call = engine._add_evaluated_program.call_args.kwargs
+    assert call["num_actual_evals"] == 0
+    assert call["birth_propose_ids"] == (3,)
+    assert call["valset_evaluation"].scores_by_val_id == {11: 0.75}
+    assert call["valset_evaluation"].outputs_by_val_id == {11: "new"}
+    engine.adapter.commit_program_observations.assert_called_once()
+
+
+def test_rejected_admission_proposal_commits_no_candidate_observation():
+    engine = _engine()
+    proposal = _proposal(before=0.75, after=0.25, admission=True)
+
+    assert not engine._run_reflective_batch([proposal], _state())
+
+    engine._evaluate_programs_on_valset.assert_not_called()
+    engine._add_evaluated_program.assert_not_called()
+    engine.adapter.commit_program_observations.assert_not_called()
+
+
+def test_default_proposal_keeps_official_val_policy_path():
+    engine = _engine()
+    proposal = _proposal(before=0.25, after=0.75, admission=False)
+    val_eval = ValsetEvaluation(outputs_by_val_id={5: "val"}, scores_by_val_id={5: 0.5})
+    engine._evaluate_programs_on_valset.return_value = [(val_eval, 1)]
+
+    assert engine._run_reflective_batch([proposal], _state())
+
+    engine._evaluate_programs_on_valset.assert_called_once_with(
+        [proposal.candidate],
+        engine._add_evaluated_program.call_args.kwargs["state"],
+    )
+    call = engine._add_evaluated_program.call_args.kwargs
+    assert call["valset_evaluation"] is val_eval
+    assert call["num_actual_evals"] == 1
+    assert call["birth_propose_ids"] is None
+    engine.adapter.commit_program_observations.assert_not_called()
+
+
+def test_birth_evaluation_overlap_fails_before_budget_or_state_mutation():
+    engine = object.__new__(GEPAEngine)
+    state = _state()
+    state.total_num_evals = 7
+    state.num_full_ds_evals = 2
+    before = (
+        state.total_num_evals,
+        state.num_full_ds_evals,
+        len(state.program_candidates),
+    )
+
+    with pytest.raises(ValueError, match="frontier-ineligible"):
+        engine._add_evaluated_program(
+            new_program={"prompt": "leaked"},
+            state=state,
+            parent_program_idx=[0],
+            valset_evaluation=ValsetEvaluation(
+                outputs_by_val_id={3: "leaked"},
+                scores_by_val_id={3: 1.0},
+            ),
+            num_actual_evals=1,
+            birth_propose_ids=(3,),
+        )
+
+    assert before == (
+        state.total_num_evals,
+        state.num_full_ds_evals,
+        len(state.program_candidates),
+    )
