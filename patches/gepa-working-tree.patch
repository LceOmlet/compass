+    def commit_existing_program_evaluation(
+        self,
+        program_idx: ProgramIdx,
+        valset_evaluation: ValsetEvaluation[RolloutOutput, DataId],
+        run_dir: str | None,
+        iteration: int,
+    ) -> tuple[DataId, ...]:
+        """Commit new scalar observations for a program already in the state.
+
+        A previously unseen instance is recorded. For an instance already
+        evaluated by this program, only a strictly higher score replaces the
+        stored score and its associated output. Equal or lower observations
+        leave the first maximum-bound observation unchanged.
+
+        This sparse update is exact for the instance frontier. GEPA does not
+        persist per-program, per-instance objective subscores, so this method
+        deliberately rejects objective-frontier updates rather than deriving
+        an incorrect aggregate from a partial batch.
+
+        The method updates state only; callers remain responsible for
+        evaluation-budget accounting.
+        """
+        if not 0 <= program_idx < len(self.program_candidates):
+            raise IndexError(f"Program index {program_idx} is out of range")
+        if self.frontier_type != "instance":
+            raise ValueError("Sparse existing-program commits require frontier_type='instance'")
+        if valset_evaluation.objective_scores_by_val_id is not None:
+            raise ValueError("Sparse existing-program commits do not support objective scores")
+
+        program_scores = self.prog_candidate_val_subscores[program_idx]
+        updated_ids: list[DataId] = []
+        for val_id, raw_score in valset_evaluation.scores_by_val_id.items():
+            score = float(raw_score)
+            if not math.isfinite(score):
+                raise ValueError("Sparse existing-program scores must be finite")
+            previous_score = program_scores.get(val_id)
+            if previous_score is not None and score <= previous_score:
+                continue
