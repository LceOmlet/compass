+    adapter.make_reflective_dataset.return_value = {
+        "c": [{"feedback": "official"}]
+    }
+    adapter.get_program_observation = None
+    adapter.commit_program_observations = None
+
+    class RecordingAdmissionHook:
+        def __init__(self):
+            self.call = None
+
+        def prepare(self, **kwargs):
+            self.call = kwargs
+            admission_ids = tuple(kwargs["admission_ids"])
+            admission_batch = tuple(kwargs["admission_batch"])
+            return AdmissionPlan(
+                evaluation_ids=admission_ids,
+                evaluation_batch=admission_batch,
+                eval_before=EvaluationBatch(
+                    outputs=["reference-0", "reference-1"],
+                    scores=[0.2, 0.3],
+                    trajectories=[
+                        {"stage": "reference-0"},
+                        {"stage": "reference-1"},
+                    ],
+                    num_metric_calls=0,
+                ),
+            )
+
+    hook = RecordingAdmissionHook()
+    proposal_sampler = EpochShuffledBatchSampler(
+        minibatch_size=1,
+        rng=random.Random(0),
+    )
+    admission_sampler = EpochShuffledBatchSampler(
+        minibatch_size=2,
+        rng=random.Random(1),
+    )
+    proposer = _make_proposer(
+        adapter=adapter,
+        candidate_selector=MagicMock(
