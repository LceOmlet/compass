+        admission_batch_sampler=admission_sampler,
+        admission_hook=hook,
+    )
+
+    proposals = proposer.propose(_make_state())
+
+    assert len(proposals) == 1
+    assert proposer.admission_set is not proposer.trainset
+    assert proposer.admission_batch_sampler is admission_sampler
+    assert hook.call is not None
+    assert len(hook.call["admission_ids"]) == 2
+    assert len(hook.call["admission_batch"]) == 2
+    assert all(
+        any(item is admission_item for admission_item in admission_data)
+        for item in hook.call["admission_batch"]
+    )
+    parent_batch = adapter.batch_evaluate.call_args_list[0].args[0][0][1]
+    child_batch = adapter.batch_evaluate.call_args_list[1].args[0][0][1]
+    assert len(parent_batch) == 1
+    assert len(child_batch) == 2
+    assert parent_batch[0]["origin"] == "proposal"
