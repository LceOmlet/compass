+    def get_program_frontier_ineligible_ids(self, program_idx: ProgramIdx) -> frozenset[DataId]:
+        """Return all ``B_propose`` IDs on a program's single-parent lineage.
+
+        ``None`` means the standard GEPA path did not enable birth
+        eligibility for this program. The seed has a known empty birth batch.
+        Admission-batch IDs are not provenance for this exclusion and remain
+        eligible unless they later occur in a lineage ``B_propose``.
+        """
+        if not 0 <= program_idx < len(self.program_candidates):
+            raise IndexError(f"Program index {program_idx} is out of range")
+        birth_ids = self.program_birth_propose_ids[program_idx]
+        if birth_ids is None or program_idx == 0:
+            return frozenset()
+
+        excluded_ids: set[DataId] = set()
+        visited: set[ProgramIdx] = set()
+        current_idx = program_idx
+        while current_idx != 0:
+            if current_idx in visited:
+                raise ValueError("Birth frontier eligibility lineage contains a cycle")
+            visited.add(current_idx)
+
+            current_birth_ids = self.program_birth_propose_ids[current_idx]
+            if current_birth_ids is None:
+                raise ValueError("Program lineage birth-proposal provenance is unavailable")
+            excluded_ids.update(current_birth_ids)
+
+            parents = [parent for parent in self.parent_program_for_candidate[current_idx] if parent is not None]
+            if len(parents) != 1:
+                raise ValueError("Birth frontier eligibility requires exactly one parent program")
+            current_idx = parents[0]
+        return frozenset(excluded_ids)
+
+    def get_prospective_frontier_ineligible_ids(
+        self,
+        parent_program_idx: ProgramIdx,
+        birth_propose_ids: Sequence[DataId],
+    ) -> frozenset[DataId]:
+        """Return the recursive ``B_propose`` exclusion for a prospective child."""
+        if self.frontier_type != "instance":
+            raise ValueError("Birth frontier eligibility requires frontier_type='instance'")
+        if not 0 <= parent_program_idx < len(self.program_candidates):
+            raise IndexError(f"Parent program index {parent_program_idx} is out of range")
+        parent_birth_ids = self.program_birth_propose_ids[parent_program_idx]
+        if parent_birth_ids is None:
+            raise ValueError("Parent birth-proposal provenance is unavailable")
+        return frozenset(birth_propose_ids).union(self.get_program_frontier_ineligible_ids(parent_program_idx))
