+    baseline = EpochShuffledBatchSampler(minibatch_size=2, rng=random.Random(0))
+    filtered = EpochShuffledBatchSampler(minibatch_size=2, rng=random.Random(0))
+
+    state = SimpleNamespace(i=0)
+    assert baseline.next_minibatch_ids(ListDataLoader(items), state) == filtered.next_minibatch_ids(
+        ListDataLoader(items), state
+    )
+    sequence = list(filtered.shuffled_ids)
+    filtered.next_minibatch_ids(
+        ListDataLoader(items),
+        state,
+        excluded_ids=(sequence[2],),
+    )
+
+    state.i = 1
+    assert filtered.next_minibatch_ids(ListDataLoader(items), state) == baseline.next_minibatch_ids(
+        ListDataLoader(items), state
+    )
