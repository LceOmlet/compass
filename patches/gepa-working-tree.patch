+def test_exclusion_stably_filters_the_official_sequence():
+    loader = ListDataLoader(list("abcdefgh"))
+    sampler = EpochShuffledBatchSampler(minibatch_size=2, rng=random.Random(0))
+    state = SimpleNamespace(i=0)
+
+    proposal = sampler.next_minibatch_ids(loader, state)
+    sequence = list(sampler.shuffled_ids)
+    assert proposal == sequence[:2]
+
+    excluded = {sequence[2]}
+    admission = sampler.next_minibatch_ids(loader, state, excluded_ids=excluded)
+    assert admission == [sequence[3], sequence[4]]
+    assert excluded.isdisjoint(admission)
+
+    # The next call in the same iteration continues after every position
+    # inspected by the filtered call, including the skipped position.
+    assert sampler.next_minibatch_ids(loader, state) == [sequence[5], sequence[6]]
