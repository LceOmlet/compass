+def test_post_proposal_admission_hook_owns_one_ordered_dynamic_batch():
+    from unittest.mock import MagicMock
+
+    from gepa.core.adapter import EvaluationBatch
+    from gepa.proposer.reflective_mutation.admission import AdmissionPlan
+
+    proposal_data = [{"origin": "proposal", "q": 0}]
+    admission_data = [
+        {"origin": "admission", "q": 10},
+        {"origin": "admission", "q": 11},
+        {"origin": "admission", "q": 12},
+    ]
+    parent_eval = EvaluationBatch(
+        outputs=["parent"],
+        scores=[0.4],
+        trajectories=[{"stage": "parent"}],
+        num_metric_calls=1,
+    )
+    child_eval = EvaluationBatch(
+        outputs=["child-1", "child-2"],
+        scores=[0.7, 0.8],
+        trajectories=[{"stage": "child-1"}, {"stage": "child-2"}],
+        num_metric_calls=2,
+    )
+    events = []
+    adapter = MagicMock()
+    adapter.propose_new_texts = None
+    evaluations = iter(([parent_eval], [child_eval]))
+
+    def batch_evaluate(_items):
+        events.append("evaluate")
+        return next(evaluations)
+
+    adapter.batch_evaluate = MagicMock(side_effect=batch_evaluate)
+    reflective_dataset = {"c": [{"feedback": "official"}]}
+    adapter.make_reflective_dataset.return_value = reflective_dataset
+    adapter.get_program_observation = None
+    adapter.commit_program_observations = None
+    adapter.record_logical_rollouts = MagicMock()
+
+    class DynamicHook:
+        def __init__(self):
+            self.calls = []
+            self.prepare = MagicMock(
+                side_effect=AssertionError("pre-proposal admission must not run")
+            )
+
+        def bind_proposal_batch_context(self, **kwargs):
+            events.append("bind")
+            assert kwargs["iteration"] == kwargs["state"].i + 1
+            assert len(kwargs["tasks"]) == 1
+
+        def prepare_after_proposals(self, **kwargs):
+            events.append("prepare")
+            self.calls.append(kwargs)
+            request = kwargs["requests"][0]
+            assert request.reflective_dataset is reflective_dataset
+            assert request.proposed_candidate == {"c": "improved"}
+            loader = kwargs["admission_set"]
+            ids = (1, 2)
+            return [
+                AdmissionPlan(
+                    evaluation_ids=ids,
+                    evaluation_batch=tuple(loader.fetch(ids)),
+                    eval_before=EvaluationBatch(
+                        outputs=["reference-1", "reference-2"],
+                        scores=[0.2, 0.3],
+                        trajectories=[
+                            {"stage": "reference-1"},
+                            {"stage": "reference-2"},
+                        ],
+                        num_metric_calls=0,
+                    ),
+                )
+            ]
+
+    hook = DynamicHook()
+    proposal_sampler = MagicMock()
+    proposal_sampler.next_minibatch_ids.return_value = [0]
+    admission_sampler = MagicMock()
+    proposer = _make_proposer(
+        adapter=adapter,
+        candidate_selector=MagicMock(select_candidate_idx=MagicMock(return_value=0)),
+        batch_sampler=proposal_sampler,
+        module_selector=MagicMock(return_value=["c"]),
+        trainset=proposal_data,
+        reflection_strategy=_FixedProposalLM({"c": "improved"}),
+        admission_set=admission_data,
+        admission_batch_sampler=admission_sampler,
+        admission_hook=hook,
+    )
+
+    proposals = proposer.propose(_make_state())
+
+    assert events == ["bind", "evaluate", "prepare", "evaluate"]
+    assert len(hook.calls) == 1
+    hook.prepare.assert_not_called()
+    admission_sampler.next_minibatch_ids.assert_not_called()
+    assert len(proposals) == 1
+    proposal = proposals[0]
+    assert proposal.subsample_indices == [1, 2]
+    assert proposal.admission_plan.birth_propose_ids == (0,)
+    assert adapter.batch_evaluate.call_args_list[1].args[0] == [
+        ({"c": "improved"}, admission_data[1:])
+    ]
+    assert [
+        call.kwargs["phase"]
+        for call in adapter.record_logical_rollouts.call_args_list
+    ] == ["propose_parent", "admit_candidate"]
+    assert (
+        adapter.record_logical_rollouts.call_args_list[0].kwargs["evaluation_ids"]
+        == [0]
+    )
+    assert (
+        adapter.record_logical_rollouts.call_args_list[1].kwargs["evaluation_ids"]
+        == (1, 2)
+    )
