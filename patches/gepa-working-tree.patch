+# Copyright (c) 2025 Lakshya A Agrawal and the GEPA contributors
+# https://github.com/gepa-ai/gepa
+
+"""Optional admission-stage extension points for reflective mutation."""
+
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+from inspect import getattr_static
+from typing import Any, Generic, Protocol
+
+from gepa.core.adapter import DataInst, EvaluationBatch, RolloutOutput, Trajectory
+from gepa.core.data_loader import DataId, DataLoader
+from gepa.core.state import GEPAState
+
+
+@dataclass(frozen=True, slots=True)
+class AdmissionPlan(Generic[DataId, DataInst, Trajectory, RolloutOutput]):
+    """Evaluation inputs and reference results for an admission-stage candidate check."""
+
+    evaluation_ids: tuple[DataId, ...]
+    evaluation_batch: tuple[DataInst, ...]
+    eval_before: EvaluationBatch[Trajectory, RolloutOutput]
+    birth_propose_ids: tuple[DataId, ...] | None = None
+
+
+class AdmissionHook(Protocol[DataId, DataInst, Trajectory, RolloutOutput]):
+    """Prepare an optional, independent admission evaluation for one reflection job."""
+
+    def prepare(
+        self,
+        *,
+        state: GEPAState[RolloutOutput, DataId],
+        parent_program_idx: int,
+        parent_candidate: dict[str, str],
+        components_to_update: Sequence[str],
+        reflective_dataset: Mapping[str, Sequence[Mapping[str, Any]]],
+        propose_evaluation: EvaluationBatch[Trajectory, RolloutOutput],
+        admission_ids: Sequence[DataId],
+        admission_batch: Sequence[DataInst],
+    ) -> AdmissionPlan[DataId, DataInst, Trajectory, RolloutOutput] | None: ...
+
+
+@dataclass(frozen=True, slots=True)
+class PostProposalAdmissionRequest(
+    Generic[DataId, DataInst, Trajectory, RolloutOutput]
+):
+    """One ordered proposal whose exact admission scope is known after reflection."""
+
+    parent_program_idx: int
+    parent_candidate: Mapping[str, str]
+    proposed_candidate: Mapping[str, str]
+    components_to_update: tuple[str, ...]
+    reflective_dataset: Mapping[str, Sequence[Mapping[str, Any]]]
+    propose_evaluation: EvaluationBatch[Trajectory, RolloutOutput]
+    birth_propose_ids: tuple[DataId, ...]
+    reflection_metadata: Mapping[str, Any]
+
+
+class PostProposalAdmissionHook(
+    AdmissionHook[DataId, DataInst, Trajectory, RolloutOutput],
+    Protocol[DataId, DataInst, Trajectory, RolloutOutput],
+):
+    """Prepare aligned dynamic admission plans after a proposal batch reflects.
+
+    This optional owner seam is for admission scopes derived by the proposal
+    operation itself.  The hook receives every successful proposal in canonical
+    task order and must return one aligned plan (or ``None``) per request.
+    Ordinary admission hooks continue to use :meth:`AdmissionHook.prepare` and
+    the configured admission sampler unchanged.
+    """
+
+    def prepare_after_proposals(
+        self,
+        *,
+        state: GEPAState[RolloutOutput, DataId],
+        admission_set: DataLoader[DataId, DataInst],
+        requests: Sequence[
+            PostProposalAdmissionRequest[
+                DataId,
+                DataInst,
+                Trajectory,
+                RolloutOutput,
+            ]
+        ],
+    ) -> Sequence[
+        AdmissionPlan[DataId, DataInst, Trajectory, RolloutOutput] | None
+    ]: ...
+
+
+def commit_adapter_observations(
+    adapter: Any,
+    *,
+    program_idx: int,
+    evaluation_ids: Sequence[DataId],
+    evaluation: EvaluationBatch[Trajectory, RolloutOutput],
+    committed_ids: Sequence[DataId],
+) -> None:
+    """Forward committed observations to adapters that expose an observation sink."""
+    commit = getattr(adapter, "commit_program_observations", None)
+    if commit is None:
+        return
+    commit(
+        program_idx=program_idx,
+        evaluation_ids=evaluation_ids,
+        evaluation=evaluation,
+        committed_ids=committed_ids,
+    )
+
+
+def record_adapter_rollouts(
+    adapter: Any,
+    *,
+    phase: str,
+    iteration: int,
+    parent_program_idx: int,
+    candidate: Mapping[str, str],
+    evaluation_ids: Sequence[DataId],
+    evaluation: EvaluationBatch[Trajectory, RolloutOutput],
+    proposal_id: str | None = None,
+) -> None:
+    """Forward an already completed, ID-aligned evaluation to an adapter sink.
+
+    The reflective proposer remains the owner of evaluation and ID alignment.
+    This optional seam only exposes those completed logical rollouts to adapters
+    that need an append-only corpus; it does not execute, retry, score, cache, or
+    commit anything.
+    """
+
+    if getattr_static(adapter, "record_logical_rollouts", None) is None:
+        return
+    record = getattr(adapter, "record_logical_rollouts")
+    record(
+        phase=phase,
+        iteration=iteration,
+        parent_program_idx=parent_program_idx,
+        candidate=candidate,
+        evaluation_ids=evaluation_ids,
+        evaluation=evaluation,
+        proposal_id=proposal_id,
+    )
