diff --git a/tests/test_admission.py b/tests/test_admission.py
new file mode 100644
index 0000000000000000000000000000000000000000..d4a6450e09df7206d05c8f0b4b799d6ad4dc5453
--- /dev/null
+++ b/tests/test_admission.py
@@ -0,0 +1,81 @@
+from gepa import AdmissionHook, AdmissionPlan, commit_adapter_observations
+from gepa.core.adapter import EvaluationBatch
+from gepa.proposer.base import CandidateProposal
+
+
+def test_admission_plan_is_an_explicit_optional_candidate_field():
+    eval_before = EvaluationBatch(
+        outputs=["old-output"],
+        scores=[0.75],
+        trajectories=[{"call": "old"}],
+    )
+    plan = AdmissionPlan(
+        evaluation_ids=(7,),
+        evaluation_batch=({"id": 7},),
+        eval_before=eval_before,
+    )
+
+    proposal = CandidateProposal(
+        candidate={"prompt": "new"},
+        parent_program_ids=[0],
+        admission_plan=plan,
+    )
+
+    assert proposal.admission_plan is plan
+    assert proposal.admission_plan.evaluation_ids == (7,)
+    assert proposal.admission_plan.evaluation_batch == ({"id": 7},)
+    assert proposal.admission_plan.eval_before is eval_before
+    assert AdmissionHook is not None
+
+
+def test_candidate_proposal_positional_constructor_remains_backward_compatible():
+    proposal = CandidateProposal(
+        {"prompt": "new"},
+        [0],
+        [3],
+        [0.25],
+        [0.5],
+        None,
+        None,
+        "reflective_mutation",
+        {"source": "default"},
+    )
+
+    assert proposal.tag == "reflective_mutation"
+    assert proposal.metadata == {"source": "default"}
+    assert proposal.admission_plan is None
+
+
+def test_commit_adapter_observations_is_an_optional_duck_typed_sink():
+    evaluation = EvaluationBatch(outputs=["out"], scores=[1.0], trajectories=[{"trace": 1}])
+
+    class StatefulAdapter:
+        def __init__(self):
+            self.call = None
+
+        def commit_program_observations(self, **kwargs):
+            self.call = kwargs
+
+    adapter = StatefulAdapter()
+    commit_adapter_observations(
+        adapter,
+        program_idx=3,
+        evaluation_ids=(8,),
+        evaluation=evaluation,
+        committed_ids=(8,),
+    )
+
+    assert adapter.call == {
+        "program_idx": 3,
+        "evaluation_ids": (8,),
+        "evaluation": evaluation,
+        "committed_ids": (8,),
+    }
+
+    commit_adapter_observations(
+        object(),
+        program_idx=3,
+        evaluation_ids=(8,),
+        evaluation=evaluation,
+        committed_ids=(),
+    )
