diff --git a/dspy/utils/exceptions.py b/dspy/utils/exceptions.py
index f088dbc..994bdad 100644
--- a/dspy/utils/exceptions.py
+++ b/dspy/utils/exceptions.py
@@ -237,11 +237,29 @@ class AdapterParseError(DSPyError):
     def __init__(
         self,
         adapter_name: str,
-        signature: Signature,
-        lm_response: str,
+        signature: Signature | None = None,
+        lm_response: str | None = None,
         message: str | None = None,
         parsed_result: str | None = None,
     ):
+        # BaseException serializes its ``args`` and reconstructs an exception
+        # by calling its constructor with those positional arguments. Older
+        # AdapterParseError instances therefore unpickle with only the fully
+        # rendered error message. Accept that reconstruction shape; the
+        # pickled instance dictionary restores the structured fields
+        # immediately afterwards.
+        if signature is None and lm_response is None:
+            self.adapter_name = adapter_name
+            self.signature = None
+            self.lm_response = None
+            self.parsed_result = None
+            super().__init__(adapter_name)
+            return
+        if signature is None or lm_response is None:
+            raise TypeError(
+                "signature and lm_response must either both be provided or both be omitted"
+            )
+
         self.adapter_name = adapter_name
         self.signature = signature
         self.lm_response = lm_response
