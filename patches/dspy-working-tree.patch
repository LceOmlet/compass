diff --git a/tests/utils/test_exceptions.py b/tests/utils/test_exceptions.py
index 707ddea..ad22cb1 100644
--- a/tests/utils/test_exceptions.py
+++ b/tests/utils/test_exceptions.py
@@ -1,3 +1,5 @@
+import cloudpickle
+
 import dspy
 from dspy.utils.exceptions import (
     AdapterParseError,
@@ -132,3 +134,24 @@ def test_adapter_parse_error_with_parsed_result():
         "Expected to find output fields in the LM response: [answer1, answer2] \n\n"
         "Actual output fields parsed from the LM response: [answer1] \n\n"
     )
+
+
+def test_adapter_parse_error_cloudpickle_round_trip():
+    signature = dspy.make_signature("question->answer1, answer2")
+    error = AdapterParseError(
+        adapter_name="ChatAdapter",
+        signature=signature,
+        lm_response="unparseable response",
+        message="Critical error, please fix!",
+        parsed_result={"answer1": "value1"},
+    )
+
+    restored = cloudpickle.loads(cloudpickle.dumps(error))
+
+    assert isinstance(restored, AdapterParseError)
+    assert str(restored) == str(error)
+    assert restored.code == "adapter_parse_error"
+    assert restored.adapter_name == error.adapter_name
+    assert restored.signature.output_fields == error.signature.output_fields
+    assert restored.lm_response == error.lm_response
+    assert restored.parsed_result == error.parsed_result
